# KVM Hospital Management System — NexusCare
# Environment Configuration Template

APP_NAME="KVM Hospital Management System — NexusCare"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Database Configuration (MySQL 8.x / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kvm_hospital
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session Hardening
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Security & Throttling
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_SECONDS=900

# Feature Toggles
ENABLE_QUEUEFLOW_AUTO_POLL=true
QUEUEFLOW_POLL_INTERVAL_SEC=12
ENABLE_BEDMATRIX_AUTO_LOCK=true
FLOWLENS_SURVEILLANCE_ACTIVE=true
TRUSTLEDGER_DETAILED_LOGGING=true
